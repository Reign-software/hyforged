$Hotbar = "../Hotbar.ui";

Group #StaminaPanel {
  LayoutMode: Bottom;
  Anchor: (
    Bottom: $Hotbar.@InventoryClosedContainerMargin + $Hotbar.@HotbarHeight + 6, 
    Width: $Hotbar.@HotbarWidthHud,
    Height: 12
  );

   Group {
    LayoutMode: Right;

    Group #StaminaBar {
      Anchor: (Height: 12, Width: 318);
      Background: @StaminaBarBackground;

      Group #StaminaBarError {
        Background: @StaminaBarBackgroundError;
      }

      Group #StaminaBarErrorOutline {
        Background: @StaminaBarBackgroundErrorOutline;
      }

      Group #StaminaBarValue {
        ProgressBar #StaminaBarDrainEffect {
          BarTexturePath: @StaminaBarDrainFiller;
        }

        ProgressBar #StaminaBarProgress {
          BarTexturePath: @StaminaBarFiller;
        }
      }

      ProgressBar #StaminaBarEffect {
        BarTexturePath: "StaminaEffect.png";
      }
    }

    Group #Icon {
      Anchor: (Width: 24, Height: 24, Left: 4, Top: -10);
      Background: "StaminaIcon.png";
    }
  }
}

Group #DebugStaminaInfo {
  LayoutMode: Top;
  Padding: (Left: 10, Right: 10);
  Anchor: (Height: 48, Width: 286, Bottom: 180);
  Background: #191d22(0.5);

  Group {
    LayoutMode: Center;

    Group {
      LayoutMode: Left;
      FlexWeight: 1;

      Label {
        Text: "Stamina: ";
        Style: (RenderBold: true, TextColor: #f85330);
      }

      Label #DebugStaminaValue {}
    }

    Group {
      LayoutMode: Right;
      FlexWeight: 1;

      Label {
        Text: "Regen Rate: ";
        Style: (RenderBold: true, TextColor: #f85330);
      }

      Label #DebugStaminaRegenRate {}
    }
  }

  Group {
    LayoutMode: Center;

    Label {
      Text: "Alert State: ";
      Style: (RenderBold: true, TextColor: #f85330);
    }

    Label #DebugStaminaAlertState {}
  }
}

@ProgressBarAnimationSpeed = 15.0;
@ErrorAnimationSpeed = 10.0;
@ProgressBarErrorThreshold = 0.1;
@ErrorFlashTimer = 0.5;
@StaminaErrorRenderValue = 5.0;
@DrainProgressBarAnimationSpeed = 8.0;
@DrainProgressTime = 0.5;
@MinimumDrainValue = 0.5;
@LowAlertOutlineOpacityStart = 0.5;
@LowAlertAnimationSpeed = 20.0;
@LowAlertFlashTimer = 0.25;
@OverdrawnAlertFlashTimer = 0.4;
@OverdrawnAlertAnimationSpeed = 20.0;

@StaminaBarBackground = "StaminaBackground.png";
@StaminaBarBackgroundError = "StaminaBackgroundError.png";
@StaminaBarBackgroundErrorOutline = "StaminaBackgroundErrorOutline.png";
@StaminaBarBackgroundOverdrawn = "StaminaBackgroundOverdrawn.png";
@StaminaBarBackgroundOverdrawnOutline = "StaminaBackgroundOverdrawnOutline.png";
@StaminaBarBackgroundDepleted = "StaminaBackgroundDepleted.png";
@StaminaBarFiller = "StaminaFill.png";
@StaminaBarFillerCreative = "CreativeStaminaFill.png";
@StaminaBarDrainFiller = "StaminaDrain.png";

@AdventureIcon = "StaminaIcon.png";
@CreativeIcon = "CreativeStaminaIcon.png";

@StaminaErrorSound = (
  SoundPath: "../../../Sounds/Stamina_Error.ogg",
  Volume: -9
);