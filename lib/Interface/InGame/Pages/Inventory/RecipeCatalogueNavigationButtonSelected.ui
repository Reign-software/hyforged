$NavigationButton = "RecipeCatalogueNavigationButton.ui";

Group {
  LayoutMode: Left;
  Anchor: (Height: 33);

  Group {
    Anchor: (Width: 6, Height: 10, Right: 8);
    Background: "../../../Common/ContainerTitleArrow.png";
  }

  Label #Label {
    Style: (...$NavigationButton.@LabelStyle, FontName: "Default", RenderBold: true, TextColor: #ffffff);
    MaskTexturePath: "HighlightedLabelGradient.png";
  }
}
