$Common = "../../Common.ui";
$Container = "../../Common/Container.ui";
$Buttons = "../../Common/Buttons.ui";
$Sounds = "../../Sounds.ui";

$Common.@Overlay #Popup {
  $Container.@DecoratedContainer {
    Anchor: (Width: 560);

    #Title {
      $Container.@Title #TitleLabel {
        @Text = %client.mainMenu.servers.editPopup.addServer;
      }
    }

    #Content {
      Padding: (Full: 24);

      Label {
        Style: $Container.@SubtitleStyle;
        Text: %client.mainMenu.servers.connectionAddress;
        Anchor: (Bottom: 10);
      }

      TextField #ServerAddress {
        Style: $Common.@DefaultInputFieldStyle;
        Background: $Common.@InputBoxBackground;
        Anchor: (Height: 44);
        Padding: (Horizontal: 10);
      }

      Label {
        Style: $Container.@SubtitleStyle;
        Text: %client.mainMenu.servers.editPopup.name;
        Anchor: (Bottom: 10, Top: 10);
      }

      TextField #Name {
        Style: $Common.@DefaultInputFieldStyle;
        Background: $Common.@InputBoxBackground;
        Anchor: (Height: 44);
        Padding: (Horizontal: 10);
      }

      Label #StatusLabel {
        Anchor: (Top: 10);
        Style: (...$Common.@DefaultLabelStyle, Wrap: true);
      }

      Group {
        Anchor: (Height: 2, Vertical: 16);
        Background: (Color: #2b3542);
      }

      Group {
        LayoutMode: Left;

        $Common.@PrimaryTextButton #SaveButton {
          @Text = %client.mainMenu.servers.editPopup.addServer;
          @Anchor = Anchor(Right: 10, MinWidth: $Common.@DefaultButtonMinWidth);
          FlexWeight: 1;
        }

        $Common.@DestructiveTextButton #RemoveButton {
          @Text = %client.general.button.remove;
          @Anchor = Anchor(Right: 10, MinWidth: $Common.@DefaultButtonMinWidth);
          FlexWeight: 1;
        }

        $Common.@SecondaryTextButton #CancelButton {
          @Text = %client.general.button.close;
          @Anchor = Anchor(MinWidth: $Common.@DefaultButtonMinWidth);
          FlexWeight: 1;
        }
      }
    }
  }
}
