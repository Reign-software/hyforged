<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions">

    <!-- EXPERIENCE BAR TEMPLATE -->
    <!--////////////////////////////////////////////////////////////////////-->

    <ControlTemplate x:Key="Template.ExperienceBar" TargetType="{x:Type ProgressBar}">
        <Grid
            x:Name="Root"
            SnapsToDevicePixels="True">

            <!-- BASE SECTION -->
            <!-- This part serves as the backer for the progress bar. It is very important to conserve the PART_Track name or it will break -->
            <Grid x:Name="PART_Track" HorizontalAlignment="Right" Visibility="Visible">
                <Viewbox Stretch="None" Visibility="Visible">
                    <Path
                        Data="M6.19355,0 0,6 6.19355,12 249.806,12 252.747,9.3197 253.051,9.04243 253.636,8.50953 256,6 249.807,0 6.19355,0z"
                        Stretch="Fill"
                        Height="20"
                        Width="256"
                        Fill="Black"
                        Clip="M10,4 4,10 10,16 246,16 252,10 246,4 10,4z"
                        StrokeThickness="8"
                        Opacity="0.3"/>
                </Viewbox>
            </Grid>

            <!-- FILL SECTION -->
            <!-- This is the part that grows or shrinks based on the value. It is very important to conserve the PART_Indicator name or it will break -->
            <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                <Viewbox Stretch="None">
                    <Path
                        Data="M6.19355,0 0,6 6.19355,12 249.806,12 252.747,9.3197 253.051,9.04243 253.636,8.50953 256,6 249.807,0 6.19355,0z"
                        Stretch="Fill"
                        Height="20"
                        Width="256"
                        Fill="{DynamicResource Color.Fill.ExperienceBar}"
                        Clip="M10,4 4,10 10,16 246,16 252,10 246,4 10,4z"
                        StrokeThickness="8">

                        <Path.Stroke>
                            <SolidColorBrush Color="#c9c9c9" Opacity="0.2"/>
                        </Path.Stroke>
                    </Path>
                </Viewbox>
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style x:Key="Style.ExperienceBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Template" Value="{StaticResource Template.ExperienceBar}"/>
    </Style>
</ResourceDictionary>
