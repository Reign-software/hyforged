<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">


    <!-- Global Font Tokens -->
    <FontFamily x:Key="Font.LexendBold">/#Lexend Bold</FontFamily>
    <FontFamily x:Key="Font.NunitoSans">/#Nunito Sans Regular</FontFamily>
    <FontFamily x:Key="Font.NunitoSansBold">/#Nunito Sans Bold</FontFamily>
    <FontFamily x:Key="Font.NunitoSansSemiBold">/#Nunito Sans SemiBold</FontFamily>
    <FontFamily x:Key="Font.NunitoSansMedium">/#Nunito Sans Medium</FontFamily>
    <FontFamily x:Key="Font.NunitoSansExtraBold">/#Nunito Sans ExtraBold</FontFamily>
    <FontFamily x:Key="Font.NotoMono">/#Noto Mono Regular</FontFamily>
    <FontFamily x:Key="Font.NotoSans">/#Noto Sans Regular</FontFamily>
    <FontFamily x:Key="Font.NotoSansBold">/#Noto Sans Bold</FontFamily>

    <!-- Legacy aliases for compatibility -->
    <FontFamily x:Key="Font.CoreSans">/#Nunito Sans Regular</FontFamily>
    <FontFamily x:Key="Font.CoreSansBold">/#Nunito Sans Bold</FontFamily>

    <!-- Global Font Size Tokens -->
    <sys:Double x:Key="Font.Size.Small">14</sys:Double>
    <sys:Double x:Key="Font.Size.Medium">16</sys:Double>
    <sys:Double x:Key="Font.Size.Default">18</sys:Double>
    <sys:Double x:Key="Font.Size.Tabs">22</sys:Double>
    <sys:Double x:Key="Font.Size.Body">20</sys:Double>
    <sys:Double x:Key="Font.Size.Heading2">22</sys:Double>
    <sys:Double x:Key="Font.Size.Heading">24</sys:Double>
    <sys:Double x:Key="Font.Size.Heading1">32</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">32</sys:Double>
    <sys:Double x:Key="Font.Size.Title">40</sys:Double>
</ResourceDictionary>
