<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
        xmlns:system="clr-namespace:System;assembly=mscorlib">

    <ControlTemplate x:Key="Template.Hotbar">
        <Grid>
            <ListBox
                x:Name="HotbarSlots"
                Background="Transparent"
                ItemsSource="{Binding Hotbar.Slots}"
                ItemContainerStyle="{DynamicResource Style.SlotHotbar}"
                ItemTemplate="{DynamicResource Content.SlotHotbar}"
                SelectionMode="Single"
                HorizontalAlignment="Stretch"
                ScrollViewer.CanContentScroll="False"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                Padding="0"
                Focusable="False">

                <!--<b:Interaction.Behaviors>
                    <GamepadItemsControlItemBehavior/>
                </b:Interaction.Behaviors>-->

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="76" ItemHeight="76"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>
    </ControlTemplate>

    <Style x:Key="Style.Hotbar" TargetType="{x:Type UserControl}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template" Value="{DynamicResource Template.Hotbar}"/>
    </Style>
</ResourceDictionary>
