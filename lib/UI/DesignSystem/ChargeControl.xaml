<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions">

    <!-- CHARGE BAR TEMPLATE -->
    <!--////////////////////////////////////////////////////////////////////-->
    <ControlTemplate x:Key="Template.ChargeControl" TargetType="ProgressBar">
        <Ellipse
            Fill="{TemplateBinding Background}"
            Stroke="{TemplateBinding Foreground}"
            StrokeThickness="2"
            RenderTransformOrigin="0.5,0.5"
            Opacity="0.75">

            <Ellipse.RenderTransform>
                <ScaleTransform
                    CenterX="0"
                    CenterY="0"
                    ScaleX="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}"
                    ScaleY="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Ellipse.RenderTransform>
        </Ellipse>
    </ControlTemplate>
</ResourceDictionary>
