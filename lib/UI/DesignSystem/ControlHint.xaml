<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

    <ControlTemplate x:Key="Template.ControlHint.Icon">
        <Border
            MinWidth="28"
            Height="28"
            Padding="4,0,4,0"
            Background="{DynamicResource Color.Background.ControlHint.Icon}"
            BorderBrush="{DynamicResource Color.BorderOutSecondary}"
            BorderThickness="2"
            CornerRadius="6"
            VerticalAlignment="Center">

            <!-- The ContentPresenter renders content inside of the control Hint icon -->
            <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>
    </ControlTemplate>

    <Style x:Key="Style.ControlHint.Icon" TargetType="ContentControl">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.LexendBold}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Medium}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template" Value="{DynamicResource Template.ControlHint.Icon}" />
    </Style>

    <Style x:Key="Style.ControlHint.Label" TargetType="TextBlock">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.CoreSansBold}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Default}"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stroke" Value="{DynamicResource Color.TextStroke}"/>
        <Setter Property="StrokeThickness" Value="3"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="Style.ControlHint.Divider" TargetType="TextBlock">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Text" Value="/"/>
        <Setter Property="Foreground" Value="{DynamicResource Color.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.CoreSansBold}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,0,4,0"/>
    </Style>

    <Style x:Key="Style.ControlHint.Layout" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
</ResourceDictionary>
