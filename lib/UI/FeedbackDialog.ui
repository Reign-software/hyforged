$Common = "Common.ui";

@TypeButtonLabelStyle = LabelStyle(
  FontSize: 18,
  RenderBold: true,
  TextColor: #ffffff,
  RenderUppercase: true,
  HorizontalAlignment: Center,
  VerticalAlignment: Center
);

@TypeButtonStyle = TextButtonStyle(
  Default: (Background: $Common.@PrimaryButtonDefaultBackground, LabelStyle: @TypeButtonLabelStyle),
  Hovered: (Background: $Common.@PrimaryButtonHoveredBackground, LabelStyle: @TypeButtonLabelStyle),
  Pressed: (Background: $Common.@PrimaryButtonPressedBackground, LabelStyle: @TypeButtonLabelStyle),
  Sounds: $Common.@ButtonSounds
);

@TypeDescriptionStyle = LabelStyle(
  FontSize: 14,
  TextColor: #96a9be,
  Wrap: true,
  HorizontalAlignment: Center
);

Group {
  LayoutMode: Middle;
  Background: #131417(0.9);

  Group {
    LayoutMode: Top;
    Background: (TexturePath: "MainMenu/ModalBackground.png", VerticalBorder: 4);
    Padding: (Vertical: 2);

    Group {
      Background: #1f2734;
      LayoutMode: Top;
      Padding: (Vertical: 35, Horizontal: 40);

      Group {
        Anchor: (Width: 800);
        LayoutMode: Top;

        Group {
          Anchor: (Height: 0);
          Background: (
            TexturePath: "Common/ContainerDecorationTop.png",
            Anchor: (Width: 236, Height: 11, Top: -42)
          );
        }

        Label #TitleLabel {
          Style: (HorizontalAlignment: Center, TextColor: #d3dee3, FontSize: 28, RenderBold: true, RenderUppercase: true);
        }

        // Type Selection View
        Group #TypeSelectionView {
          LayoutMode: Top;
          Anchor: (Top: 30);

          Label {
            Text: %client.feedback.selectType;
            Style: (HorizontalAlignment: Center, TextColor: #96a9be, FontSize: 16);
            Anchor: (Bottom: 25);
          }

          Group {
            LayoutMode: Center;
            Anchor: (Height: 180);

            Group {
              Anchor: (Width: 280, Right: 20);
              LayoutMode: Top;

              TextButton #SelectBugReportButton {
                Anchor: (Height: 50);
                Style: @TypeButtonStyle;
                Text: %client.feedback.type.bugreport;
              }

              Label {
                Text: %client.feedback.bugreport.description;
                Style: @TypeDescriptionStyle;
                Anchor: (Top: 15);
              }
            }

            Group {
              Anchor: (Width: 280, Left: 20);
              LayoutMode: Top;

              TextButton #SelectFeedbackButton {
                Anchor: (Height: 50);
                Style: @TypeButtonStyle;
                Text: %client.feedback.type.feedback;
              }

              Label {
                Text: %client.feedback.feedback.description;
                Style: @TypeDescriptionStyle;
                Anchor: (Top: 15);
              }
            }
          }
        }

        // Form View (hidden initially)
        Group #FormView {
          LayoutMode: Top;
          Visible: false;

          // Abuse Warning
          Group {
            LayoutMode: Left;
            Anchor: (Top: 20);
            Background: (Color: #3d2a1a);
            Padding: (Horizontal: 15, Vertical: 10);

            Label {
              Text: %client.feedback.warning.abuse;
              Style: (TextColor: #d4a574, FontSize: 14, VerticalAlignment: Center, Wrap: true);
              Anchor: (Left: 0);
            }
          }

          // Category Field
          Group {
            LayoutMode: Top;
            Anchor: (Top: 15);

            Label {
              Text: %client.feedback.field.category;
              Style: (TextColor: #96a9be, FontSize: 14, RenderBold: true, RenderUppercase: true);
            }

            DropdownBox #CategoryDropdown {
              Anchor: (Top: 5, Height: 35);
              Style: (
                ...$Common.@DefaultDropdownBoxStyle,
                HorizontalPadding: 10,
                PanelAlign: Bottom,
                PanelOffset: 0,
                LabelStyle: (
                  ...$Common.@DefaultDropdownBoxLabelStyle,
                  FontSize: 14,
                  RenderBold: true
                )
              );
            }
          }

          // Support Redirect (accounts/billing only)
          Group #SupportRedirectView {
            LayoutMode: Top;
            Anchor: (Top: 15);
            Visible: false;

            Label {
              Text: %client.feedback.redirect.support;
              Style: (TextColor: #96a9be, FontSize: 14, Wrap: true);
            }

            $Common.@PrimaryTextButton #SupportRedirectButton {
              @Text = %client.feedback.redirect.button;
              @Anchor = Anchor(Top: 10, MinWidth: 200);
            }
          }

          Group #FormFieldsView {
            LayoutMode: Top;

            // Summary Field
            Group {
              LayoutMode: Top;
              Anchor: (Top: 15);

              Label {
                Text: %client.feedback.field.summary;
                Style: (TextColor: #96a9be, FontSize: 14, RenderBold: true, RenderUppercase: true);
              }

              TextField #SummaryField {
                Anchor: (Top: 5, Height: 35);
                Background: $Common.@InputBoxBackground;
                MaxLength: 100;
                Padding: (Horizontal: 10, Vertical: 8);
                Style: $Common.@DefaultInputFieldStyle;
                PlaceholderStyle: $Common.@DefaultInputFieldPlaceholderStyle;
                PlaceholderText: %client.feedback.field.summary.placeholder;
              }
            }

            // Description Field
            Group {
              LayoutMode: Top;
              Anchor: (Top: 15);

              Label {
                Text: %client.feedback.field.description;
                Style: (TextColor: #96a9be, FontSize: 14, RenderBold: true, RenderUppercase: true);
              }

              MultilineTextField #DescriptionField {
                Anchor: (Top: 5, Height: 150);
                Background: $Common.@InputBoxBackground;
                MaxVisibleLines: 8;
                AutoGrow: false;
                MaxLength: 1000;
                ContentPadding: (Horizontal: 10, Vertical: 8);
                Style: $Common.@DefaultInputFieldStyle;
                PlaceholderStyle: $Common.@DefaultInputFieldPlaceholderStyle;
                PlaceholderText: %client.feedback.field.description.placeholder;
              }
            }

            // Include Log File Section (Bug Reports Only)
            Group #IncludeLogFileSection {
              LayoutMode: Left;
              Anchor: (Top: 15);
              Visible: false;

              CheckBox #IncludeLogFileCheckbox {
                Anchor: (Width: 22, Height: 22);
                Background: (TexturePath: "Common/CheckBoxFrame.png", Border: 7);
                Padding: (Full: 4);
                Style: $Common.@DefaultCheckBoxStyle;
              }

              Label {
                Text: %client.feedback.bugreport.includeLogFile;
                Style: (TextColor: #96a9be, FontSize: 14, VerticalAlignment: Center);
                Anchor: (Left: 10);
              }
            }

            // Attachments Section
            Group {
              LayoutMode: Top;
              Anchor: (Top: 15);

              Label {
                Text: %client.feedback.field.attachments;
                Style: (TextColor: #96a9be, FontSize: 14, RenderBold: true, RenderUppercase: true);
              }

              Group {
                LayoutMode: Left;

                $Common.@SecondaryTextButton #AddScreenshotButton {
                  @Text = %client.feedback.attachments.addScreenshot;
                  @Anchor = Anchor(Top: 5);
                }

                $Common.@SecondaryTextButton #AddLogFileButton {
                  @Text = %client.feedback.attachments.addLogFile;
                  @Anchor = Anchor(Top: 5, Left: 10);
                }
              }

              Group #AttachmentsList {
                LayoutMode: Top;
                Anchor: (Top: 10);
                Padding: 10;
                Background: $Common.@InputBoxBackground;
                Visible: false;
              }
            }

            // Error Box
            Group #ErrorBox {
              LayoutMode: Top;
              Anchor: (Top: 15);
              Background: (Color: #4a1f1f);
              Padding: (Horizontal: 15, Vertical: 10);
              Visible: false;

              Label #ErrorLabel {
                Text: "";
                Style: (TextColor: #ff6b6b, FontSize: 14, Wrap: true);
              }
            }
          }
        }

        // Success View (hidden initially)
        Group #SuccessView {
          LayoutMode: Top;
          Anchor: (Top: 30);
          Visible: false;

          Label #SuccessMessageLabel {
            Text: "";
            Style: (TextColor: #d3dee3, FontSize: 16, Wrap: true, HorizontalAlignment: Center);
          }

          Label #SuccessReportIdLabel {
            Text: "";
            Anchor: (Top: 8);
            Style: (TextColor: #9aa3ab, FontSize: 13, Wrap: true, HorizontalAlignment: Center);
          }
        }
      }
    }

    Group {
      Background: #353432;
      Anchor: (Height: 1);
    }

    Group #ButtonBar {
      LayoutMode: Center;
      Anchor: (Height: 83);
      Background: (TexturePath: "MainMenu/ModalDecoration.png", Anchor: (Width: 448));

      $Common.@PrimaryTextButton #SubmitButton {
        @Text = "";
        @Anchor = Anchor(Right: 5, Left: 5, MinWidth: 244);
      }

      $Common.@SecondaryTextButton #CancelButton {
        @Text = "";
        @Anchor = Anchor(Right: 5, Left: 5, MinWidth: 244);
      }
    }

    Group {
      Anchor: (Height: 0);
      Background: (
        TexturePath: "Common/ContainerDecorationBottom.png",
        Anchor: (Width: 236, Height: 11, Bottom: -6)
      );
    }
  }
}
