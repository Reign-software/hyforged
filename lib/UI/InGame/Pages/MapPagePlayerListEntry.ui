$Common = "../../Common.ui";
$Sounds = "../../Sounds.ui";

Button {
  Anchor: (Width: 370);
  Style: (
    Hovered: (
      Background: #000000(0.2)
    )
  );
  Disabled: true;
  LayoutMode: Left;

  Group #SameWorldIcon {
    Anchor: (Width: 16, Height: 16, Left: 6);
    Background: (TexturePath: "MapIcons/SameWorld.png");
    Visible: false;
    TooltipText: %client.map.playerList.inWorld;
    TextTooltipStyle: $Common.@ButtonTextTooltipStyle;
  }

  Label #Username {
    Text: "Player 1";
    Style: (FontSize: 15, TextColor: #b7b8b9, VerticalAlignment: Center);
    Anchor: (Height: 32, Left: 8);
    FlexWeight: 1;
  }

  Label #Ping {
    Text: "";
    Style: (FontSize: 13, TextColor: #96a9be(0.6), VerticalAlignment: Center, HorizontalAlignment: End);
    Anchor: (Height: 32, Width: 50, Right: 8);
  }

  Group {
    Anchor: (Width: 50, Right: 0);
    LayoutMode: Left;

    ToggleButton #MapToggle {
      Anchor: (Width: 20, Height: 20);
      TooltipText: %client.map.playerListEntry.tooltip.map;
      TextTooltipStyle: $Common.@ButtonTextTooltipStyle;
      Style: (
        Default: (Background: "MapIcons/MapOff.png"),
        Pressed: (Background: (TexturePath: "MapIcons/MapOff.png", Color: #ffffff(0.6))),
        Hovered: (Background: (TexturePath: "MapIcons/MapOff.png", Color: #ffffff(0.8))),
        Sounds: $Sounds.@ButtonsLight
      );
      CheckedStyle: (
        Default: (Background: "MapIcons/MapOn.png"),
        Hovered: (Background: (TexturePath: "MapIcons/MapOn.png", Color: #ffffff(0.8))),
        Pressed: (Background: (TexturePath: "MapIcons/MapOn.png", Color: #ffffff(0.6))),
        Sounds: $Sounds.@ButtonsLight
      );
    }

    Group {
      FlexWeight: 1;
    }

    ToggleButton #CompassToggle {
      Anchor: (Width: 20, Height: 20);
      TooltipText: %client.map.playerListEntry.tooltip.compass;
      TextTooltipStyle: $Common.@ButtonTextTooltipStyle;
      Style: (
        Default: (Background: "MapIcons/CompassOff.png"),
        Pressed: (Background: (TexturePath: "MapIcons/CompassOff.png", Color: #ffffff(0.6))),
        Hovered: (Background: (TexturePath: "MapIcons/CompassOff.png", Color: #ffffff(0.8))),
        Sounds: $Sounds.@ButtonsLight
      );
      CheckedStyle: (
        Default: (Background: "MapIcons/CompassOn.png"),
        Hovered: (Background: (TexturePath: "MapIcons/CompassOn.png", Color: #ffffff(0.8))),
        Pressed: (Background: (TexturePath: "MapIcons/CompassOn.png", Color: #ffffff(0.6))),
        Sounds: $Sounds.@ButtonsLight
      );
    }
  }
}
