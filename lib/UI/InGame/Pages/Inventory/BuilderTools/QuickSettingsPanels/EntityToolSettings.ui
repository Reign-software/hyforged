$CommonStyles = "QuickSettingsPanelsCommon.ui";
$Label = "../Label.ui";
$SectionContainer = "../SectionContainer.ui";
$Common = "../../../../../Common.ui";

Group #EntityToolSettingsPanel {
  LayoutMode: Top;

  $SectionContainer.@SectionContainer {
    Group {
      LayoutMode: Left;
      FlexWeight: 1;
      Label { Text: %client.builderTools.panel.surfaceLock; Style: $Label.@DefaultLabelStyle; }
    }
    $CommonStyles.@CheckBox #SurfaceLockCheckbox {}
  }

  $SectionContainer.@SectionContainer {
    Group {
      LayoutMode: Left;
      FlexWeight: 1;
      Label { Text: %client.builderTools.panel.gridSnap; Style: $Label.@DefaultLabelStyle; }
    }
    $CommonStyles.@CheckBox #GridSnapCheckbox {}
  }

  Group #GridSizeContainer {
    $SectionContainer.@SectionContainer {
      Group {
        LayoutMode: Left;
        FlexWeight: 1;
        Label { Text: %client.builderTools.panel.gridSize; Style: $Label.@DefaultLabelStyle; }
      }
      FloatSliderNumberField #GridSizeSlider {
        Anchor: (Width: 250, Height: 5, Right: 0);
        Padding: (Left: 8);
        SliderStyle: $Common.@DefaultSliderStyle;
        NumberFieldContainerAnchor: (Left: 15, Width: 30, Height: 15);
        NumberFieldStyle: (...$Common.@DefaultInputFieldStyle, RenderBold: true, FontSize: 14, TextColor: #a5b4c4);
        NumberFieldMaxDecimalPlaces: 1;
        Min: 0;
        Max: 10;
        Step: 0.1;
        Value: 0.5;
      }
    }
  }
}
