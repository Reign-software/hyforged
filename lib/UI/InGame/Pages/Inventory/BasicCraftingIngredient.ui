$InGame = "../../Common.ui";
$Common = "../../../Common.ui";

@SlotInvalidBackground = PatchStyle(TexturePath: "IngredientSlot.png", Border: 24);
@SlotValidBackground = PatchStyle(TexturePath: "IngredientSlotValid.png", Border: 24);
@InvalidColor = #D13B3B;
@ValidColor = #48d185;

Group #Container {
  Anchor: (Height: 72, Left: 0);
  LayoutMode: Left;

  Group #SlotBackground {
    Anchor: (Height: 72, Width: 72);
  }

  Group {
    LayoutMode: Middle;
    Anchor: (Left: 10);
    FlexWeight: 1;

    Label #NameLabel {
      Style: (Wrap: true, TextColor: #819395, FontSize: 14);
    }

    Group {
      LayoutMode: Left;
      Anchor: (Top: 4);

      Label #QuantityLabel {
        Anchor: (Height: 20);
        Style: (TextColor: #819395, FontSize: 15, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: false);
      }

      Group #NearbyContainerIndicator {
        Anchor: (Height: 16, Width: 16, Left: 7);
        Background: (TexturePath: "Chest.png");
        TooltipText: %client.inventory.crafting.ingredient.tooltip.pullingFromChests;
        TextTooltipStyle: (...$Common.@ButtonTextTooltipStyle, MaxWidth: 300, LabelStyle: (FontSize: 14, Wrap: true));
        Visible: false;
      }
    }
  }
}
