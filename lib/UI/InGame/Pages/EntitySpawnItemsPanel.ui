$Common = "../../Common.ui";
$InGame = "../Common.ui";
$Container = "../../Common/Container.ui";
$Sounds = "../../Sounds.ui";

Group {
  LayoutMode: Top;
  Anchor: (Right: 50, Top: 150, Width: 640);

  TabNavigation #PrimaryCategoryTabs {
    Anchor: (Height: 62 + 4, Left: 2, Right: 0);
    Style: $Container.@IconOnlyTopTabsStyle;
  }

  $Container.@Container #Panel {
    @ContentPadding = Padding(Full: 15, Right: 7);

    #Title {
      Group {
        LayoutMode: Left;

        TabNavigation #SecondaryCategoryTabs {
          Anchor: (Height: 17, Left: 4);
          Style: $Container.@HeaderTabsStyle;
        }

        Group {
          FlexWeight: 1;
        }

        $Container.@HeaderSearch #Search {
          @MarginRight = 0;
        }

        Group {
          Anchor: (Width: 49, Right: 4);

          ToggleButton #ToggleVariantsButton {
            Anchor: (Width: 34, Right: 10);
            TooltipText: %client.inventory.itemLibrary.options.showVariants;
            TextTooltipStyle: $Common.@ButtonTextTooltipStyle;
            Style: (
              Default: (Background: "Inventory/BlockIcon.png"),
              Pressed: (Background: (TexturePath: "Inventory/BlockIcon.png", Color: #ffffff(0.6))),
              Hovered: (Background: (TexturePath: "Inventory/BlockIcon.png", Color: #ffffff(0.8))),
            );
            CheckedStyle: (
              Default: (Background: "Inventory/BlockIconSelected.png"),
              Hovered: (Background: (TexturePath: "Inventory/BlockIconSelected.png", Color: #ffffff(0.8))),
              Pressed: (Background: (TexturePath: "Inventory/BlockIconSelected.png", Color: #ffffff(0.6))),
            );
          }
        }
      }
    }

    #Content {
      LayoutMode: Top;

      Group {
        Anchor: (Height: $InGame.@DefaultItemSlotSize * 9 + $InGame.@DefaultItemSlotSpacing * 8);

        ItemGrid #ItemGrid {
          SlotsPerRow: 8;
          Style: $InGame.@DefaultItemGridStyle;
          ScrollbarStyle: $Common.@TranslucentScrollbarStyle;
          ShowScrollbar: true;
          Background: (Color: $InGame.@DefaultItemGridBackground, Anchor: (Right: 8));
          Padding: $InGame.@DefaultItemGridPadding;
          KeepScrollPosition: true;
        }
      }
    }
  }
}
