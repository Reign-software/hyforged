$InGame = "../Common.ui";

@SpecialItemGridStyle = (
  ...$InGame.@DefaultItemGridStyle,
  SlotBackground: "../Pages/Inventory/SpecialSlot.png"
);

@BottomMargin = 30;
@ContainerMargin = 6;

@InventoryClosedContainerMargin = @BottomMargin + @ContainerMargin;
@InventoryOpenedContainerMargin = 0;
@SpecialSlotHighlightSize = 88;

@HotbarUp = (
  SoundPath: "../../Sounds/Hotbar_Up.ogg",
  Volume: -14
);

@SelectorPreviewContainerSize = 68;
@SelectorPreviewSlotSize = 32;
@SelectorPreviewSlotIconSize = 30;

@HotbarSlotSpacingHud = 4;
@HotbarSlotSpacingMenu = 2;

@HotbarWidthHud = $InGame.@DefaultItemSlotSize * $InGame.@DefaultItemSlotsPerRow + @HotbarSlotSpacingHud * $InGame.@DefaultItemSlotsPerRow;
@HotbarWidthMenu = $InGame.@DefaultItemSlotSize * $InGame.@DefaultItemSlotsPerRow + @HotbarSlotSpacingMenu * $InGame.@DefaultItemSlotsPerRow;
@HotbarHeight = $InGame.@DefaultItemSlotSize + (2 * $InGame.@DefaultItemGridPadding);

Group #Container {
  Anchor: (
    Bottom: @InventoryClosedContainerMargin,
    Width: @HotbarWidthHud,
    Height: @HotbarHeight
  );

  Group #UtilitySlotContainer {
    Anchor: (
      Left: -28 - $InGame.@DefaultItemSlotSize,
      Width: $InGame.@DefaultItemSlotSize + (2 * $InGame.@DefaultItemGridPadding),
      Height: $InGame.@DefaultItemSlotSize + (2 * $InGame.@DefaultItemGridPadding)
    );

    Group {
      Background: "HotbarDivider.png";
      Anchor: (Width: 4, Height: 74, Right: -14);
    }

    Group #UtilitySlotPointer {
      Anchor: (
        Left: 3,
        Top: -80,
        Width: 72,
        Height: 135
      );
      Background: "SpecialSlotPointer.png";
      Visible: false;
    }

    ItemGrid #UtilitySlotItemGrid {
      Style: @SpecialItemGridStyle;
      SlotsPerRow: 1;
      RenderItemQualityBackground: true;
      AreItemsDraggable: false;
      Background: $InGame.@DefaultItemGridBackground;
      Padding: $InGame.@DefaultItemGridPadding;
    }

    Group #Highlight {
      Background: "../Pages/Inventory/SpecialSlotHighlight.png";
      Anchor: (Width: @SpecialSlotHighlightSize, Height: @SpecialSlotHighlightSize, Left: 2 - (@SpecialSlotHighlightSize - $InGame.@DefaultItemSlotSize) / 2, Top: 2 - (@SpecialSlotHighlightSize - $InGame.@DefaultItemSlotSize) / 2);
      Visible: false;
    }

    Group {
      Anchor: (Width: $InGame.@DefaultItemSlotSize, Height: $InGame.@DefaultItemSlotSize);
      LayoutMode: Left;

      Label #InputBinding {
        Background: "HotKeyBackground.png";
        Style: (
          Alignment: Center,
          FontSize: 12,
          RenderBold: true,
          TextColor: #919191
        );
        Padding: (Horizontal: 5);
        Anchor: (
          Height: 18,
          Top: 4,
          Left: 4,
        );
      }
    }
  }

  ItemGrid #ItemGrid {
    SlotsPerRow: $InGame.@DefaultItemSlotsPerRow;
    Style: (
      ...$InGame.@DefaultItemGridStyle,
      SlotSpacing: @HotbarSlotSpacingHud
    );
    Background: $InGame.@DefaultItemGridBackground;
    Padding: $InGame.@DefaultItemGridPadding;
  }

  // TODO: To re-implement properly so progress bar doesn't go over item icon if we go with this design
  Group #ActiveSlotOverlay {
    Background: "ActiveSlot.png";
    Anchor: (Width: 112, Height: 112);
  }

  Group #CooldownOverlay1 {
    Anchor: (Left: $InGame.@DefaultItemSlotSize-($InGame.@DefaultItemSlotSize * $InGame.@DefaultItemSlotsPerRow + $InGame.@DefaultItemSlotSpacing * ($InGame.@DefaultItemSlotsPerRow - 1) + 4));
    ProgressBar #CooldownProgress1a {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    ProgressBar #CooldownProgress1b {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    Group {
      Anchor: (Width: 100, Height: 100);
      Background: "SignatureReady.png";
      Visible: false;
    }
  }

  Group #CooldownOverlay2 {
    Anchor: (Left: $InGame.@DefaultItemSlotSize-($InGame.@DefaultItemSlotSize * ($InGame.@DefaultItemSlotsPerRow - 2) + $InGame.@DefaultItemSlotSpacing * ($InGame.@DefaultItemSlotsPerRow - 4) + 4));
    ProgressBar #CooldownProgress2a {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    ProgressBar #CooldownProgress2b {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    Group {
      Anchor: (Width: 100, Height: 100);
      Background: "SignatureReady.png";
      Visible: false;
    }
  }

  Group #CooldownOverlay3 {
    Anchor: (Left: $InGame.@DefaultItemSlotSize-($InGame.@DefaultItemSlotSize * ($InGame.@DefaultItemSlotsPerRow - 4) + $InGame.@DefaultItemSlotSpacing * ($InGame.@DefaultItemSlotsPerRow - 6) + 4));
    ProgressBar #CooldownProgress3a {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    ProgressBar #CooldownProgress3b {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    Group {
      Anchor: (Width: 100, Height: 100);
      Background: "SignatureReady.png";
      Visible: false;
    }
  }

  Group #CooldownOverlay4 {
    Anchor: (Left: $InGame.@DefaultItemSlotSize-($InGame.@DefaultItemSlotSize * ($InGame.@DefaultItemSlotsPerRow - 6) + $InGame.@DefaultItemSlotSpacing * ($InGame.@DefaultItemSlotsPerRow - 8) + 4));
    ProgressBar #CooldownProgress4a {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    ProgressBar #CooldownProgress4b {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    Group {
      Anchor: (Width: 100, Height: 100);
      Background: "SignatureReady.png";
      Visible: false;
    }
  }

  Group #CooldownOverlay5 {
    ProgressBar #CooldownProgress5a {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    ProgressBar #CooldownProgress5b {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    Group {
      Anchor: (Width: 100, Height: 100);
      Background: "SignatureReady.png";
      Visible: false;
    }
  }

  Group #CooldownOverlay6 {
    Anchor: (Right: $InGame.@DefaultItemSlotSize-($InGame.@DefaultItemSlotSize * ($InGame.@DefaultItemSlotsPerRow - 6) + $InGame.@DefaultItemSlotSpacing * ($InGame.@DefaultItemSlotsPerRow - 8) + 4));
    ProgressBar #CooldownProgress6a {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    ProgressBar #CooldownProgress6b {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    Group {
      Anchor: (Width: 100, Height: 100);
      Background: "SignatureReady.png";
      Visible: false;
    }
  }

  Group #CooldownOverlay7 {
    Anchor: (Right: $InGame.@DefaultItemSlotSize-($InGame.@DefaultItemSlotSize * ($InGame.@DefaultItemSlotsPerRow - 4) + $InGame.@DefaultItemSlotSpacing * ($InGame.@DefaultItemSlotsPerRow - 6) + 4));
    ProgressBar #CooldownProgress7a {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    ProgressBar #CooldownProgress7b {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    Group {
      Anchor: (Width: 100, Height: 100);
      Background: "SignatureReady.png";
      Visible: false;
    }
  }

  Group #CooldownOverlay8 {
    Anchor: (Right: $InGame.@DefaultItemSlotSize-($InGame.@DefaultItemSlotSize * ($InGame.@DefaultItemSlotsPerRow - 2) + $InGame.@DefaultItemSlotSpacing * ($InGame.@DefaultItemSlotsPerRow - 4) + 4));
    ProgressBar #CooldownProgress8a {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    ProgressBar #CooldownProgress8b {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    Group {
      Anchor: (Width: 100, Height: 100);
      Background: "SignatureReady.png";
      Visible: false;
    }
  }

  Group #CooldownOverlay9 {
    Anchor: (Right: $InGame.@DefaultItemSlotSize-($InGame.@DefaultItemSlotSize * ($InGame.@DefaultItemSlotsPerRow) + $InGame.@DefaultItemSlotSpacing * ($InGame.@DefaultItemSlotsPerRow - 1) + 4));
    ProgressBar #CooldownProgress9a {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    ProgressBar #CooldownProgress9b {
      Anchor: (Width: 70, Height: 70);
      BarTexturePath: "SignatureNotReady.png";
      Alignment: Vertical;
      Direction: Start;
    }

    Group {
      Anchor: (Width: 100, Height: 100);
      Background: "SignatureReady.png";
      Visible: false;
    }
  }
}

Label #ActiveItemNameLabel {
  Anchor: (Bottom: $InGame.@DefaultItemSlotSpacing + $InGame.@DefaultItemSlotSize + 50, Height: 40);
  Style: (Alignment: Center, OutlineColor: #000000(0.1));
  Visible: false;
}
