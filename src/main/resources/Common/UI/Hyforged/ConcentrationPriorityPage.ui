// Hyforged Concentration Priority Queue UI

Panel #ConcentrationPriorityPage {
    Style: (Alignment: Center, Padding: 20, Layout: Vertical, Gap: 12);

    Panel #Header {
        Style: (Layout: Vertical, Gap: 4);

        Label #Title {
            Text: "Concentration Priorities";
            Style: (FontSize: 20, FontWeight: Bold, Alignment: Center);
        }

        Label #CurrentConcentration {
            Text: 0/0;
            Style: (FontSize: 12, Alignment: Center, Color: #bbbbbb);
        }

        Label #Hint {
            Text: "Reorder abilities with the arrows; lower items drop first.";
            Style: (FontSize: 11, Alignment: Center, Color: #888888);
        }
    }

    Panel #PriorityList {
        Style: (Layout: Vertical, Gap: 6);
    }

    Panel #Footer {
        Style: (Layout: Horizontal, Gap: 10, Alignment: Center, Margin: (Top: 8));

        Button #RefreshButton {
            Text: Refresh;
            Style: (Width: 110);
        }

        Button #CloseButton {
            Text: Close;
            Style: (Width: 110);
        }
    }
}
