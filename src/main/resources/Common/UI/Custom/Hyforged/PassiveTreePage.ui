// Hyforged Passive Tree Page UI
// Uses Button elements for interactive clickable areas

$Common = "../Common.ui";

Group #PassiveTreePage {
    LayoutMode: Top;
    Anchor: (Width: 800, Height: 700);
    Background: $Common.@InputBoxBackground;
    Padding: (Full: 20);

    // Header
    Group #Header {
        LayoutMode: Top;
        Anchor: (Height: 50);
        Label #TreeName { 
            Text: "Passive Tree"; 
            Style: (FontSize: 24, Alignment: Center, RenderBold: true);
        }
        Label #TreeType { 
            Text: ""; 
            Style: (FontSize: 14, Alignment: Center);
        }
    }

    // Tree Selector Tabs
    Group #TreeSelector {
        LayoutMode: Left;
        Anchor: (Height: 40);
        Padding: (Top: 10);

        Button #GeneralTreeTab {
            Anchor: (Width: 100, Height: 35);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Padding: (Full: 8);
            Label { Text: "[General]"; Style: (FontSize: 12, Alignment: Center); }
        }

        Button #ClassTreeTab {
            Anchor: (Width: 100, Height: 35, Left: 10);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Padding: (Full: 8);
            Label { Text: "[Class]"; Style: (FontSize: 12, Alignment: Center); }
        }
    }

    // Point Summary
    Group #PointSummary {
        LayoutMode: Top;
        Padding: (Top: 10);
        Anchor: (Height: 80);
        Label #PointsTitle { 
            Text: "Points"; 
            Style: (FontSize: 16, RenderBold: true);
        }
        Label #AvailableLabel { Text: "Available:"; Style: (FontSize: 12); }
        Label #AvailableValue { Text: "0"; Style: (FontSize: 12); }
        Label #AllocatedLabel { Text: "Allocated:"; Style: (FontSize: 12); }
        Label #AllocatedValue { Text: "0"; Style: (FontSize: 12); }
        Label #MaxLabel { Text: "Max:"; Style: (FontSize: 12); }
        Label #MaxValue { Text: "0"; Style: (FontSize: 12); }
        // Book points row (for general tree)
        Group #BookPointsRow {
            LayoutMode: Left;
            Label #BookPointsLabel { Text: "Book Points:"; Style: (FontSize: 12); }
            Label #BookPointsValue { Text: "0"; Style: (FontSize: 12); }
        }
    }

    // Selected Node Info Panel
    Group #SelectedNodePanel {
        LayoutMode: Top;
        Padding: (Top: 10);
        Anchor: (Height: 120);
        Label #SelectedNodeTitle { 
            Text: "Selected Node"; 
            Style: (FontSize: 16, RenderBold: true);
        }
        Label #SelectedNodeName { Text: ""; Style: (FontSize: 14); }
        Label #SelectedNodeType { Text: ""; Style: (FontSize: 12); }
        Label #SelectedNodeDesc { Text: ""; Style: (FontSize: 12); }
        Label #SelectedNodeEffects { Text: ""; Style: (FontSize: 12); }
        
        Group #NodeActions {
            LayoutMode: Left;
            Padding: (Top: 5);
            
            Button #AllocateButton {
                Anchor: (Width: 100, Height: 30);
                Background: $Common.@InputBoxBackground;
                Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
                Padding: (Full: 5);
                Label { Text: "[Allocate]"; Style: (FontSize: 12, Alignment: Center); }
            }

            Button #RefundButton {
                Anchor: (Width: 100, Height: 30, Left: 10);
                Background: $Common.@InputBoxBackground;
                Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
                Padding: (Full: 5);
                Label { Text: "[Refund]"; Style: (FontSize: 12, Alignment: Center); }
            }
        }
    }

    // Search Panel
    Group #SearchPanel {
        LayoutMode: Left;
        Padding: (Top: 10);
        Anchor: (Height: 40);
        Label #SearchLabel { Text: "Search:"; Style: (FontSize: 12); }
        TextField #SearchInput {
            Anchor: (Width: 200, Height: 30, Left: 10);
            Style: $Common.@DefaultInputFieldStyle;
            Background: $Common.@InputBoxBackground;
        }
        Button #ClearSearch {
            Anchor: (Width: 70, Height: 30, Left: 10);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Padding: (Full: 5);
            Label { Text: "[Clear]"; Style: (FontSize: 12, Alignment: Center); }
        }
    }

    // Controls Panel
    Group #ControlsPanel {
        LayoutMode: Left;
        Padding: (Top: 10);
        Anchor: (Height: 40);

        Button #ZoomIn {
            Anchor: (Width: 40, Height: 30);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Label { Text: "[+]"; Style: (FontSize: 14, Alignment: Center); }
        }

        Button #ZoomOut {
            Anchor: (Width: 40, Height: 30, Left: 5);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Label { Text: "[-]"; Style: (FontSize: 14, Alignment: Center); }
        }

        Button #ZoomReset {
            Anchor: (Width: 70, Height: 30, Left: 10);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Padding: (Full: 5);
            Label { Text: "[Reset]"; Style: (FontSize: 12, Alignment: Center); }
        }

        Button #FullRespec {
            Anchor: (Width: 100, Height: 30, Left: 20);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Padding: (Full: 5);
            Label { Text: "[Respec All]"; Style: (FontSize: 12, Alignment: Center); }
        }

        Button #UndoLast {
            Anchor: (Width: 80, Height: 30, Left: 10);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Padding: (Full: 5);
            Label { Text: "[Undo]"; Style: (FontSize: 12, Alignment: Center); }
        }

        Button #ComparisonToggle {
            Anchor: (Width: 100, Height: 30, Left: 10);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Padding: (Full: 5);
            Label { Text: "[Compare]"; Style: (FontSize: 12, Alignment: Center); }
        }

        Label #ZoomLevel {
            Anchor: (Width: 60, Height: 30, Left: 10);
            Text: "100%";
            Style: (FontSize: 12, Alignment: Center);
        }
    }

    // Tree Canvas (container for dynamically rendered nodes/lines)
    Group #TreeCanvas {
        LayoutMode: Top;
        Padding: (Top: 10);
        Anchor: (Height: 300);
        Background: $Common.@InputBoxBackground;
    }

    // Node List (simplified tree view - fallback display)
    Group #NodeList {
        LayoutMode: Top;
        Padding: (Top: 10);
        Label #NodeListTitle { 
            Text: "Nodes"; 
            Style: (FontSize: 16, RenderBold: true);
        }
        Label #Node0 { Text: ""; Style: (FontSize: 12); }
        Label #Node1 { Text: ""; Style: (FontSize: 12); }
        Label #Node2 { Text: ""; Style: (FontSize: 12); }
        Label #Node3 { Text: ""; Style: (FontSize: 12); }
        Label #Node4 { Text: ""; Style: (FontSize: 12); }
        Label #Node5 { Text: ""; Style: (FontSize: 12); }
        Label #Node6 { Text: ""; Style: (FontSize: 12); }
        Label #Node7 { Text: ""; Style: (FontSize: 12); }
        Label #Node8 { Text: ""; Style: (FontSize: 12); }
        Label #Node9 { Text: ""; Style: (FontSize: 12); }
    }

    // Status Messages
    Group #StatusPanel {
        LayoutMode: Top;
        Padding: (Top: 5);
        Label #StatusMessage { Text: ""; Style: (FontSize: 12); }
        Label #ErrorMessage { Text: ""; Style: (FontSize: 12, TextColor: #ff4444); }
    }

    // Confirmation Dialog (hidden by default)
    Group #ConfirmDialog {
        LayoutMode: Top;
        Padding: (Top: 10);
        Label #ConfirmTitle { 
            Text: "Confirm"; 
            Style: (FontSize: 16, RenderBold: true);
        }
        Label #ConfirmMessage { Text: ""; Style: (FontSize: 12); }
        
        Group #ConfirmButtons {
            LayoutMode: Left;
            Padding: (Top: 5);
            
            Button #ConfirmAccept {
                Anchor: (Width: 80, Height: 30);
                Background: $Common.@InputBoxBackground;
                Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
                Padding: (Full: 5);
                Label { Text: "[Yes]"; Style: (FontSize: 12, Alignment: Center); }
            }

            Button #ConfirmCancel {
                Anchor: (Width: 80, Height: 30, Left: 10);
                Background: $Common.@InputBoxBackground;
                Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
                Padding: (Full: 5);
                Label { Text: "[No]"; Style: (FontSize: 12, Alignment: Center); }
            }
        }
    }

    // Confirmation Overlay (for respec confirmation - hidden by default)
    Group #ConfirmationOverlay {
        Visible: false;
        LayoutMode: Top;
        Padding: (Full: 10);
        Background: $Common.@InputBoxBackground;
        
        Group #CostSummary {
            Visible: false;
            LayoutMode: Top;
            Label #CostSummaryTitle { Text: "Cost Summary"; Style: (FontSize: 14, RenderBold: true); }
            Group #NodeCountRow {
                LayoutMode: Left;
                Label #NodeCountLabel { Text: "Nodes:"; Style: (FontSize: 12); }
                Label #NodeCountValue { Text: "0"; Style: (FontSize: 12); }
            }
            Group #TotalCostRow {
                LayoutMode: Left;
                Label #TotalCostLabel { Text: "Total Cost:"; Style: (FontSize: 12); }
                Label #TotalCostValue { Text: "0"; Style: (FontSize: 12); }
            }
            Group #BalanceRow {
                LayoutMode: Left;
                Label #BalanceLabel { Text: "Balance:"; Style: (FontSize: 12); }
                Label #BalanceValue { Text: "0"; Style: (FontSize: 12); }
            }
        }
        
        Group #KeystonePreview {
            Visible: false;
            LayoutMode: Top;
        }
    }

    // Tooltip Overlay (for node hover - hidden by default)
    Group #TooltipOverlay {
        Visible: false;
        LayoutMode: Top;
        Padding: (Full: 10);
        Background: $Common.@InputBoxBackground;
        
        Label #TooltipName { Text: ""; Style: (FontSize: 14, RenderBold: true); }
        Label #TooltipType { Text: ""; Style: (FontSize: 12); }
        Label #TooltipDescription { Text: ""; Style: (FontSize: 12); }
        
        Group #PathCostPanel {
            Visible: false;
            LayoutMode: Left;
            Label #PathCostLabel { Text: "Path Cost:"; Style: (FontSize: 12); }
            Label #PathCostValue { Text: "0"; Style: (FontSize: 12); }
        }
        
        Group #RefundCostPanel {
            Visible: false;
            LayoutMode: Left;
            Label #RefundCostLabel { Text: "Refund Cost:"; Style: (FontSize: 12); }
            Label #RefundCostValue { Text: "0"; Style: (FontSize: 12); }
        }
        
        Group #ComparisonStatsPanel {
            Visible: false;
            LayoutMode: Top;
            Label #ComparisonStatsTitle { Text: "Stat Changes"; Style: (FontSize: 12, RenderBold: true); }
        }
    }

    // Notification Panel (for messages - hidden by default)
    Group #NotificationPanel {
        Visible: false;
        LayoutMode: Top;
        Padding: (Full: 10);
        Background: $Common.@InputBoxBackground;
        Label #NotificationText { Text: ""; Style: (FontSize: 12); }
    }

    // Region Selection Overlay (for class tree selection - hidden by default)
    Group #RegionSelectionOverlay {
        Visible: false;
        LayoutMode: Top;
        Padding: (Full: 10);
        Background: $Common.@InputBoxBackground;
        Label #RegionSelectionTitle { Text: "Select Region"; Style: (FontSize: 14, RenderBold: true); }
    }

    // Class Tree Selection Overlay (for class selection - hidden by default)
    Group #ClassTreeSelectionOverlay {
        Visible: false;
        LayoutMode: Top;
        Padding: (Full: 10);
        Background: $Common.@InputBoxBackground;
        Label #ClassTreeSelectionTitle { Text: "Select Class"; Style: (FontSize: 14, RenderBold: true); }
    }

    // Comparison Panel (for stat comparison mode - hidden by default)
    Group #ComparisonPanel {
        Visible: false;
        LayoutMode: Top;
        Padding: (Full: 10);
        Background: $Common.@InputBoxBackground;
        Label #ComparisonTitle { Text: "Comparison Mode"; Style: (FontSize: 14, RenderBold: true); }
        Label #ComparisonInstructions { Text: "Hover over a node to compare stat changes"; Style: (FontSize: 12); }
    }

    // Footer with Close Button
    Group #Footer {
        LayoutMode: Top;
        Padding: (Top: 10);
        
        Button #CloseButton {
            LayoutMode: Center;
            Anchor: (Width: 100, Height: 40);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Padding: (Full: 8);
            Label { Text: "[Close]"; Style: (FontSize: 14, Alignment: Center); }
        }
    }
}
