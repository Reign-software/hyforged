// Hyforged Combat Log HUD - minimal layout using Custom UI markup

Group #CombatLogHud {
    LayoutMode: Top;

    Group #CombatLogHeader {
        LayoutMode: Top;
        Label #CombatLogTitle { Text: "Combat Log"; }
        Label #CombatLogToggle { Text: "[x]"; }
    }

    Group #CombatLogList {
        LayoutMode: Top;
        Label #LogEntry0 { Text: ""; }
        Label #LogEntry1 { Text: ""; }
        Label #LogEntry2 { Text: ""; }
        Label #LogEntry3 { Text: ""; }
        Label #LogEntry4 { Text: ""; }
        Label #LogEntry5 { Text: ""; }
        Label #LogEntry6 { Text: ""; }
        Label #LogEntry7 { Text: ""; }
        Label #LogEntry8 { Text: ""; }
        Label #LogEntry9 { Text: ""; }
        Label #LogEntry10 { Text: ""; }
        Label #LogEntry11 { Text: ""; }
    }

    Group #CombatLogFooter {
        LayoutMode: Top;
        Label #DpsLabel { Text: "DPS: ----"; }
        Label #HitsLabel { Text: "Hits: 0"; }
        Label #CritsLabel { Text: "Crits: 0"; }
    }
}
