// Hyforged Currency HUD (Tradebar balance display)

$Common = "../Common.ui";

Group #HyforgedCurrencyHud {
    LayoutMode: Top;
    Anchor: (Width: 180, Height: 80);
    Padding: (Full: 5);

    Group #InventorySection {
        LayoutMode: Left;
        Anchor: (Height: 20);
        
        Label #InventoryIcon {
            Text: "💰";
            Style: (FontSize: 14);
            Anchor: (Width: 25);
        }
        
        Label #InventoryLabel {
            Text: "Inv: ";
            Style: (FontSize: 12, TextColor: #AAAAAA);
            Anchor: (Width: 35);
        }
        
        Label #InventoryBalance {
            Text: "0";
            Style: (FontSize: 12, TextColor: #FFD700);
        }
    }

    Group #VaultSection {
        LayoutMode: Left;
        Anchor: (Height: 20);
        Visible: false;
        
        Label #VaultIcon {
            Text: "🏦";
            Style: (FontSize: 14);
            Anchor: (Width: 25);
        }
        
        Label #VaultLabel {
            Text: "Vault: ";
            Style: (FontSize: 12, TextColor: #AAAAAA);
            Anchor: (Width: 35);
        }
        
        Label #VaultBalance {
            Text: "0";
            Style: (FontSize: 12, TextColor: #6CD36C);
        }
    }

    Group #TotalSection {
        LayoutMode: Left;
        Anchor: (Height: 20);
        Visible: false;
        Padding: (Top: 5);
        
        Label #TotalIcon {
            Text: "∑";
            Style: (FontSize: 14, TextColor: #FFD700);
            Anchor: (Width: 25);
        }
        
        Label #TotalLabel {
            Text: "Total: ";
            Style: (FontSize: 12, RenderBold: true, TextColor: #AAAAAA);
            Anchor: (Width: 35);
        }
        
        Label #TotalBalance {
            Text: "0";
            Style: (FontSize: 12, RenderBold: true, TextColor: #FFD700);
        }
    }
}
