// Stat table row for CharacterStatsPage
// Each child label is set independently via descendant selectors
// e.g. #StatCategories[n] #StatName.TextSpans

$Common = "../Common.ui";

Group #StatRow {
    LayoutMode: Left;
    Anchor: (Height: 22);

    Label #StatName {
        Text: "";
        Anchor: (Width: 270);
        Style: (FontSize: 13);
    }

    Label #BaseValue {
        Text: "";
        Anchor: (Width: 110);
        Style: (FontSize: 13, HorizontalAlignment: End);
    }

    Button #ModValue {
        Anchor: (Width: 130, Height: 22);
        Background: #00000000;
        Style: ButtonStyle(Sounds: $Common.@ButtonSounds);

        Label #ModValueLabel {
            Text: "";
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            Style: (FontSize: 13, HorizontalAlignment: End);
        }
    }

    Label #RangeValue {
        Text: "";
        Anchor: (Width: 140);
        Style: (FontSize: 13, HorizontalAlignment: End, TextColor: #888888);
    }

    Label #TotalValue {
        Text: "";
        Anchor: (Width: 110);
        Style: (FontSize: 13, HorizontalAlignment: End, RenderBold: true);
    }

}
