// Hyforged Character Hub Page UI
// Central navigation for character-related screens
// Uses Button elements for interactive clickable areas

$Common = "../Common.ui";

Group #CharacterHubPage {
    LayoutMode: Top;
    Anchor: (Width: 600, Height: 500);
    Background: $Common.@InputBoxBackground;
    Padding: (Full: 20);

    // Header
    Group #Header {
        LayoutMode: Top;
        Anchor: (Height: 60);
        Label #Title { 
            Text: "Character Hub"; 
            Style: (FontSize: 24, Alignment: Center, RenderBold: true);
        }
        Label #PlayerName { 
            Text: ""; 
            Style: (FontSize: 14, Alignment: Center);
        }
    }

    // Navigation Buttons
    Group #Navigation {
        LayoutMode: Top;
        Padding: (Top: 10);

        // Character Stats Button
        Button #StatsButton {
            LayoutMode: Left;
            Anchor: (Height: 50);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Padding: (Full: 10);
            Label { 
                Text: "[Character Stats] - View attributes, modifiers, and equipment"; 
                Style: (FontSize: 14);
            }
        }

        // Passive Tree Button
        Button #PassiveTreeButton {
            LayoutMode: Left;
            Anchor: (Height: 50, Top: 5);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Padding: (Full: 10);
            Label { 
                Text: "[Passive Tree] - Allocate passive skill points"; 
                Style: (FontSize: 14);
            }
        }

        // Concentration Priority Button
        Button #ConcentrationButton {
            LayoutMode: Left;
            Anchor: (Height: 50, Top: 5);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Padding: (Full: 10);
            Label { 
                Text: "[Concentration Priority] - Manage ability focus order"; 
                Style: (FontSize: 14);
            }
        }
    }

    // Character Summary (quick info)
    Group #Summary {
        LayoutMode: Top;
        Padding: (Top: 20);
        Anchor: (Height: 120);
        Label #SummaryTitle { 
            Text: "Quick Stats"; 
            Style: (FontSize: 16, RenderBold: true);
        }
        Label #LevelInfo { Text: "Level: 1"; Style: (FontSize: 12); }
        Label #ClassInfo { Text: "Class: None"; Style: (FontSize: 12); }
        Label #HealthInfo { Text: "Health: 100/100"; Style: (FontSize: 12); }
        Label #PassivePoints { Text: "Passive Points: 0"; Style: (FontSize: 12); }
    }

    // Footer with Close Button
    Group #Footer {
        LayoutMode: Top;
        Padding: (Top: 20);
        Button #CloseButton {
            LayoutMode: Center;
            Anchor: (Width: 100, Height: 40);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Label { 
                Text: "[Close]"; 
                Style: (FontSize: 14, Alignment: Center);
            }
        }
    }
}
