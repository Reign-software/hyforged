// Hyforged Character Stats Page UI
// Table-style layout with Base / Modifier / Effective columns
// Categories and stats are populated dynamically by CharacterStatsPage.java

$Common = "../Common.ui";

Group #CharacterStatsPage {
    LayoutMode: Top;
    Anchor: (Width: 900, Height: 600);
    Background: $Common.@InputBoxBackground;
    Padding: (Full: 20);

    // Header
    Group #Header {
        LayoutMode: Top;
        Anchor: (Height: 40);
        Label #Title {
            Text: "Character Stats";
            Style: (FontSize: 24, Alignment: Center, RenderBold: true);
        }
    }

    // Column Headers (static row above scrollable content)
    Group #ColumnHeaders {
        LayoutMode: Left;
        Anchor: (Height: 22);
        Padding: (Top: 6, Bottom: 4);

        Label #ColStat {
            Text: "Stat";
            Anchor: (Width: 270);
            Style: (FontSize: 13, RenderBold: true, TextColor: #AAAAAA);
        }

        Label #ColBase {
            Text: "Base";
            Anchor: (Width: 110);
            Style: (FontSize: 13, RenderBold: true, HorizontalAlignment: End, TextColor: #AAAAAA);
        }

        Label #ColMod {
            Text: "Modifier";
            Anchor: (Width: 130);
            Style: (FontSize: 13, RenderBold: true, HorizontalAlignment: End, TextColor: #AAAAAA);
        }

        Label #ColRange {
            Text: "Range";
            Anchor: (Width: 140);
            Style: (FontSize: 13, RenderBold: true, HorizontalAlignment: End, TextColor: #AAAAAA);
        }

        Label #ColTotal {
            Text: "Effective";
            Anchor: (Width: 110);
            Style: (FontSize: 13, RenderBold: true, HorizontalAlignment: End, TextColor: #AAAAAA);
        }
    }

    // Main Content - Scrollable
    Group #Content {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $Common.@DefaultScrollbarStyle;
        Anchor: (Bottom: 60);

        // Dynamic stat categories container - populated by Java
        Group #StatCategories {
            LayoutMode: Top;
        }

        // Equipment summary below stats
        Group #EquipmentColumn {
            LayoutMode: Top;
            Padding: (Top: 14);

            Label #EquipmentTitle {
                Text: "Equipment";
                Style: (FontSize: 16, RenderBold: true, TextColor: #DAA520);
            }

            Group #ArmorSlots {
                LayoutMode: Top;
                Padding: (Top: 4);
                Label #Armor0 { Text: ""; Style: (FontSize: 13); }
                Label #Armor1 { Text: ""; Style: (FontSize: 13); }
                Label #Armor2 { Text: ""; Style: (FontSize: 13); }
                Label #Armor3 { Text: ""; Style: (FontSize: 13); }
            }

            Group #HandSlots {
                LayoutMode: Top;
                Padding: (Top: 4);
                Label #Hand0 { Text: ""; Style: (FontSize: 13); }
                Label #Hand1 { Text: ""; Style: (FontSize: 13); }
            }
        }
    }

    // Footer with Buttons
    Group #Footer {
        LayoutMode: Left;
        Anchor: (Bottom: 0, Height: 50);

        Button #PassiveTreeButton {
            Anchor: (Width: 120, Height: 40);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Padding: (Full: 8);
            Label { Text: "Passive Tree"; Style: (FontSize: 13, Alignment: Center); }
        }

        Button #RefreshButton {
            Anchor: (Width: 100, Height: 40, Left: 10);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Padding: (Full: 8);
            Label { Text: "Refresh"; Style: (FontSize: 13, Alignment: Center); }
        }

        Button #CloseButton {
            Anchor: (Width: 80, Height: 40, Left: 10);
            Background: $Common.@InputBoxBackground;
            Style: ButtonStyle(Sounds: $Common.@ButtonSounds);
            Padding: (Full: 8);
            Label { Text: "Close"; Style: (FontSize: 13, Alignment: Center); }
        }
    }
}
