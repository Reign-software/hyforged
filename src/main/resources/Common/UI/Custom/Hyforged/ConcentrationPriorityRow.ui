// Row template for the concentration priority list

Group #PriorityRow {
    LayoutMode: Top;

    Label #OrderIndex {
        Text: "1";
    }

    Group #AbilityDetails {
        LayoutMode: Top;

        Label #AbilityName {
            Text: "Ability Name";
        }

        Label #AbilityId {
            Text: "namespace:ability-id";
        }
    }

    Group #CostColumn {
        LayoutMode: Top;

        Label #CostLabel {
            Text: "Cost";
        }

        Label #Cost {
            Text: "0";
        }
    }

    Label #Status {
        Text: "Enabled";
    }

    Group #Controls {
        LayoutMode: Left;

        Button #MoveUp {
            Anchor: (Width: 40, Height: 30);
            Style: ButtonStyle();
            Label { Text: "[Up]"; Style: (FontSize: 10, Alignment: Center); }
        }

        Button #MoveDown {
            Anchor: (Width: 40, Height: 30, Left: 5);
            Style: ButtonStyle();
            Label { Text: "[Down]"; Style: (FontSize: 10, Alignment: Center); }
        }
    }
}
